# Провайдер AI: mock, ollama, openai_compat
LLM_PROVIDER=mock

# Назва моделі
LLM_MODEL=mock-study-v1

# Ключ API — для mock не потрібен
LLM_API_KEY=

# Тайм-аут у секундах
LLM_TIMEOUT_S=15

# Шлях до SQLite
DB_PATH=data/study.db

# Файл журналу
LOG_FILE=logs/app.jsonl

# Версія
APP_VERSION=pr14

# Затримка mock у мілісекундах
MOCK_DELAY_MS=0

# Частка збоїв: від 0 до 1
MOCK_FAILURE_RATE=0

# none, timeout, rate_limit,
# unavailable, invalid_json, mid_stream
MOCK_FAILURE_KIND=none