# Провайдер AI: mock, ollama, openai_compat
LLM_PROVIDER=mock

# Назва моделі
LLM_MODEL=mock-study-v1

# Ключ API — для mock не потрібен
LLM_API_KEY=

# Тайм-аут у секундах
LLM_TIMEOUT_S=120

# Шлях до SQLite
DB_PATH=data/study.db

# Файл журналу
LOG_FILE=logs/app.jsonl

# Версія
APP_VERSION=pr15

# Затримка mock у мілісекундах
MOCK_DELAY_MS=0

# Частка збоїв: від 0 до 1

=0

# none, timeout, rate_limit,
# unavailable, invalid_json, mid_stream
MOCK_FAILURE_KIND=none

LLM_BASE_URL=http://localhost:11434/v1

DAILY_CALL_LIMIT=40
CONTEXT_MAX_CHARS=10000
PROMPT_FILE=prompts/study/v1.md

RAG_ENABLED=false
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_INDEX_PATH=.rag_index/notes.json
RAG_TOP_K=3
RAG_MIN_SCORE=0.25